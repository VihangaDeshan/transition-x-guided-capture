{
  "name": "transition-x-guided-capture",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "licenses": "node scripts/check-licenses.js",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "54.0.36",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.10.2",
    "@types/react": "~19.1.0",
    "jest": "30.5.2",
    "jest-expo": "54.0.13",
    "typescript": "~5.9.2"
  },
  "private": true,
  "license": "Apache-2.0",
  "description": "Guided indoor capture for Rysera Innovations (Transition X): React Native UI + Kotlin ARCore native module",
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/android/"
    ]
  },
  "main": "index.ts"
}
